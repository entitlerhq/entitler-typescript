{
  "name": "@entitlerhq/entitler",
  "version": "0.1.0",
  "description": "The official Entitler SDK for TypeScript and JavaScript: feature checks, usage, pricing and billing.",
  "license": "MIT",
  "author": "1843 Inc.",
  "homepage": "https://github.com/entitlerhq/entitler-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entitlerhq/entitler-typescript.git"
  },
  "bugs": "https://github.com/entitlerhq/entitler-typescript/issues",
  "keywords": [
    "entitler",
    "entitlements",
    "feature-flags",
    "billing",
    "usage",
    "pricing",
    "saas"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "generate": "bun scripts/generate.ts",
    "vectors": "bun scripts/snapshot-vectors.ts",
    "test": "vitest run test/unit",
    "test:coverage": "vitest run test/unit --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.10",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
